# Viscan AI Dental Assistant - Environment Variables Template

# LLM Provider Configuration ('auto', 'groq', 'ollama', or 'deterministic')
LLM_PROVIDER=auto

# Optional: Groq API Key (Free tier available at https://console.groq.com)
GROQ_API_KEY=

# Optional: Local Ollama Endpoint (if running open-source Llama-3.1 / Qwen-2.5 locally)
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# Server Settings
PORT=8000
HOST=127.0.0.1
